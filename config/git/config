[alias]
  pristine = !git reset --hard && git clean -dffx
[color]
  ui = auto
[color "branch"]
  current = cyan bold reverse
  local = white
  plain =
  remote = cyan
[color "diff"]
  commit =
  func = cyan
  plain =
  whitespace = magenta reverse
  meta = white
  frag = cyan bold reverse
  old = red
  new = green
[color "grep"]
  context =
  filename =
  function =
  linenumber = white
  match =
  selected =
  separator =
[color "interactive"]
  error =
  header =
  help =
  prompt =
[color "status"]
  added = green
  changed = yellow
  header =
  localBranch =
  nobranch =
  remoteBranch = cyan bold
  unmerged = magenta bold reverse
  untracked = red
  updated = green bold
[commit]
  gpgsign = true
[core]
  autocrlf = false
  longpaths = true
  safecrlf = false
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
[init]
  defaultBranch = main
  templateDir = ~/.config/git/init-template
[merge]
  tool = code
[mergetool "code"]
  cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
[user]
  name = Thiago Garbazza
  email = 1093328+thiagogarbazza@users.noreply.github.com
  signingkey = ~/.config/ssh/id_ed25519_github
